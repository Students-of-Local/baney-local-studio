[Unit]
Description=Local Studio e2e gate on main's head, local model
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/local-studio-e2e.env
WorkingDirectory=%h/Projects/_work/local-studio-e2e
ExecStart=/usr/bin/env bash -c 'git fetch -q origin main && git checkout -qf --detach FETCH_HEAD && git clean -fdq && exec scripts/e2e.sh --post'
TimeoutStartSec=8h
Nice=10
