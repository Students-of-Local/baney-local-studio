// Local Studio relay deploy config, generated from relay/wrangler.jsonc by `npm run build`.
// The local app deploys relay.js with it to the person's own account (relay/deploy.md),
// passing --name to choose the address. No account_id: wrangler uses the signed-in account.
{
  "name": "local-studio-relay",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "enable_request_signal"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "Relay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Relay"
      ]
    }
  ],
  "main": "relay.js",
  "no_bundle": true
}
